#!/bin/sh
# wacli launcher — prefers the engine installed by /whatsapp-setup
# (~/.claude/whatsapp/engine), then an installed wacli (Homebrew, PATH;
# never recurses into this stub). WACLI_PATH overrides everything.
[ -n "$WACLI_PATH" ] && exec "$WACLI_PATH" "$@"
ENGINE="$HOME/.claude/whatsapp/engine/wacli"
[ -x "$ENGINE" ] && exec "$ENGINE" "$@"
for c in /opt/homebrew/bin/wacli /usr/local/bin/wacli /home/linuxbrew/.linuxbrew/bin/wacli; do
  [ -x "$c" ] && exec "$c" "$@"
done
echo "wacli: engine not installed — run /whatsapp-setup (or: brew install openclaw/tap/wacli)" >&2
exit 127
